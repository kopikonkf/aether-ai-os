  "metrics": {
    "prediction_accuracy": {
      "type": "gauge",
      "source": "world_model.db/consequences",
      "computation": "1 - avg(surprise_score) over last 100",
      "current": 0.55,
      "target": 0.70,
      "trend": "stable",
      "improvement_path": "pattern_finder → better signal selection → higher accuracy",
      "related_goals": ["improve_prediction"],
      "related_metrics": ["surprise_score", "confidence"],
      "collection": "metrics_bus.py → record('prediction_accuracy', value)",
      "pulse_frequency": "every 5 episodes"
    },
    "self_model_accuracy": {
      "type": "gauge",
      "source": "self_model.db/self_state",
