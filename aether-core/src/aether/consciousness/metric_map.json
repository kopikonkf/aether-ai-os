      "current": 0.46,
      "target": 0.65,
      "trend": "stable",
      "improvement_path": "calibrate traits against actual outcomes → evidence traces",
      "related_goals": ["improve_self_understanding"],
      "related_metrics": ["stability", "trait_accuracy"],
      "collection": "metrics_bus.py → record('self_model_accuracy', value)",
      "pulse_frequency": "every 5 episodes"
    },
    "belief_calibration": {
      "type": "gauge",
      "source": "decisions.db/beliefs + belief_evidence",
      "computation": "evidence_score * 0.6 + confidence_health * 0.4",
      "current": 0.979,
      "target": 0.80,
      "trend": "stable",
      "improvement_path": "already high — maintain through lifecycle engine",
      "related_goals": ["integrate_knowledge"],
      "related_metrics": ["evidence_count", "avg_confidence"],
      "collection": "metrics_bus.py → record('belief_calibration', value)",
      "pulse_frequency": "every 5 episodes"
    },
    "concept_formation": {
      "type": "gauge",
      "source": "consciousness.db/instances + patterns + concepts",
