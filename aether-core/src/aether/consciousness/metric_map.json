      "current": 0.375,
      "target": 0.60,
      "trend": "stable",
      "improvement_path": "more instances → pattern detection → concept formation → meta",
      "related_goals": ["integrate_knowledge"],
      "related_metrics": ["instance_count", "pattern_count", "concept_count"],
      "collection": "metrics_bus.py → record('concept_formation', value)",
      "pulse_frequency": "every 5 episodes"
    },
    "goal_completion": {
      "type": "ratio",
      "source": "decisions.db/active_goals",
      "computation": "completed / total",
      "current": 0.10,
      "target": 0.50,
      "trend": "stable",
      "improvement_path": "goal_generator → auto_generate → track progress → complete",
      "related_goals": ["improve_prediction", "improve_self_understanding", "integrate_knowledge"],
      "related_metrics": ["active_goals", "completed_goals"],
      "collection": "metrics_bus.py → record('goal_completion', value)",
      "pulse_frequency": "every 5 episodes"
    }
