# Aether runtime paths
# Windows: %LOCALAPPDATA%\Aether by default
# Linux/macOS: ~/.aether by default
# AETHER_HOME=/absolute/path/to/aether-data

# Concrete model providers are gateway concerns.
ARZASTORE_API_KEY=
OPENAGENTIC_API_KEY=
KENARI_API_KEY=
GEMINI_API_KEY=

# Telegram is optional. Offline ingestion works without polling.
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=

# Gateway
HOST=127.0.0.1
PORT=8000

# MCP / auth
MCP_MODE=pass_through
AUTH_SECRET_KEY=change-me-in-production

# Trusted approval inbox. API/AionUi approval writes are disabled until set.
AETHER_OPERATOR_ID=founder
AETHER_OPERATOR_TOKEN=
AETHER_APPROVAL_TTL_SECONDS=900

# Runtime driver fleet. Secret values should be stored in files and referenced.
AETHER_OPENCODE_BIN=
AETHER_OPENCODE_API_KEY_FILE=
AETHER_OPENCODE_AUTH_FILE=
AETHER_OPENCODE_MODEL=opencode/north-mini-code-free

AETHER_GEMINI_BIN=
AETHER_GEMINI_API_KEY_FILE=
AETHER_GEMINI_CREDENTIALS_FILE=
AETHER_GEMINI_MODEL=gemini-2.5-flash

AETHER_CLAUDE_BIN=
AETHER_CLAUDE_API_KEY_FILE=
AETHER_CLAUDE_CONFIG_DIR=
AETHER_CLAUDE_MODEL=sonnet

AETHER_CODEX_BIN=
AETHER_CODEX_HOME=
AETHER_CODEX_MODEL=

# Aether Runtime Fleet Operations (v0.16)
AETHER_FLEET_SCHEDULER_ENABLED=true
AETHER_FLEET_POLL_INTERVAL_SECONDS=10
# Queue-only by default. Set true only when automatic receipt renewal is intended.
AETHER_FLEET_AUTO_RENEW=false
# Native AionUi main-process connection.
AETHER_GATEWAY_URL=http://127.0.0.1:8000

# Mission Orchestrator + External CEE opportunity loop (v0.17)
# Maximum mission steps executed before Aether persists a bounded continuation checkpoint.
AETHER_MISSION_MAX_STEPS_PER_RUN=5

# Live Web Intelligence + Reversible Experiments (v0.19)
# Source endpoints, domain allowlists, and opaque credential handles are configured
# through the authenticated API. Credential values must not be placed in source config.
# Example handle forms: file:/secure/key, env:SEARCH_API_KEY, vault:path/to/secret
# Crawl4AI remains optional; install it only in the Gateway/runtime environment.

# Unified Browser Senses + LiveKit sidecar (v0.19.2)
# Browser session secret and worker token are generated by founder_bringup.py init.
AETHER_BROWSER_SENSE_SECRET=
AETHER_BROWSER_SENSE_TTL_SECONDS=3600
AETHER_VISION_MAX_FRAME_BYTES=750000
AETHER_SENSE_WORKER_TOKEN=
AETHER_PUBLIC_BASE_URL=https://aether.example.com

# LiveKit Cloud or a self-hosted LiveKit deployment. Values are deployment secrets.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_AGENT_NAME=aether-sense
AETHER_STT_MODEL=deepgram/nova-3
AETHER_STT_LANGUAGE=multi
AETHER_TTS_MODEL=cartesia/sonic-3
AETHER_TTS_VOICE=794f9389-aac1-45b6-b726-9d9369183238
# Ordered LiveKit Inference fallbacks. Voice entries must align by position.
AETHER_STT_FALLBACK_MODELS=
AETHER_TTS_FALLBACK_MODELS=
AETHER_TTS_FALLBACK_VOICES=
# Enables AETHER_HOME-backed budgets/circuits for Gateway cognition routing.
AETHER_PROVIDER_RESILIENCE_ENABLED=false
AETHER_TURN_DETECTOR=multilingual
AETHER_SENSE_GREETING=Aether online. Saya siap mendengar.
