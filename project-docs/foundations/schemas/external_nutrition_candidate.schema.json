{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aether.local/schemas/external-nutrition-candidate.v1.json",
  "title": "Aether External Nutrition Candidate",
  "type": "object",
  "required": [
    "candidate_id",
    "repository",
    "commit_sha",
    "artifact_path",
    "artifact_hash",
    "license",
    "publisher",
    "requested_source_capabilities",
    "required_adapter_ids",
    "normalization_target",
    "deterministic_checks",
    "heldout_checks",
    "activation_state"
  ],
  "properties": {
    "candidate_id": {"type": "string", "minLength": 1},
    "repository": {"type": "string", "minLength": 1},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-fA-F]{40}$"},
    "artifact_path": {"type": "string", "minLength": 1},
    "artifact_hash": {"type": "string", "pattern": "^[0-9a-fA-F]{64}$"},
    "license": {"type": "string", "minLength": 1},
    "publisher": {"type": "string", "minLength": 1},
    "requested_source_capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["search", "fetch", "crawl", "extract", "catalog", "platform-read"]}
    },
    "required_adapter_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "normalization_target": {"type": "string", "minLength": 1},
    "deterministic_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "heldout_checks": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "side_effects": {"type": "array", "items": {"type": "string"}},
    "runtime_requirements": {"type": "array", "items": {"type": "string"}},
    "credential_requirements": {"type": "array", "items": {"type": "string"}},
    "network_destinations": {"type": "array", "items": {"type": "string"}},
    "install_behavior": {"type": "array", "items": {"type": "string"}},
    "update_behavior": {"type": "array", "items": {"type": "string"}},
    "activation_state": {
      "enum": ["discovered", "snapshotted", "classified", "normalized", "sandboxed", "benchmarked", "approved", "active", "rejected", "archived"]
    },
    "metadata": {"type": "object"}
  },
  "additionalProperties": false
}
