[Unit]
Description=Aether Gateway sidecar
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=aether
Group=aether
WorkingDirectory=/opt/aether
EnvironmentFile=/etc/aether/aether.env
ExecStart=/opt/aether/.venv/bin/aether-gateway
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/aether

[Install]
WantedBy=multi-user.target
