[Unit]
Description=Aether LiveKit browser-sense worker
After=network-online.target aether-gateway.service
Wants=network-online.target
Requires=aether-gateway.service

[Service]
Type=simple
User=aether
Group=aether
WorkingDirectory=/opt/aether
EnvironmentFile=/etc/aether/aether.env
Environment=AETHER_GATEWAY_URL=http://127.0.0.1:8000
ExecStart=/opt/aether/.venv/bin/aether-sense-worker start
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/aether

[Install]
WantedBy=multi-user.target
